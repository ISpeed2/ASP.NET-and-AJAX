@model AgeResultModel
@{
    ViewData["Title"] = "Результат";
}

<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <main class="container mt-5" style="max-width: 640px;">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h1 class="h3 mb-0">Результат расчета</h1>
            </div>
            <div class="card-body">
                <p><strong>Имя:</strong> @Model.UserName</p>
                <p><strong>Возраст:</strong> @Model.Age лет</p>

                @if (Model.IsAdult)
                {
                    <div class="alert alert-info">Вы совершеннолетний</div>
                }
                else
                {
                    <div class="alert alert-warning">Вы несовершеннолетний</div>
                }

                <a href="/age" class="btn btn-primary">Вернуться назад</a>
            </div>
        </div>
    </main>
</body>
</html>
