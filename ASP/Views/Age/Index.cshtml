@{
    ViewData["Title"] = "Расчет возраста";
}

<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <main class="container py-5" style="max-width: 640px;">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <h1 class="mb-2">Расчет возраста</h1>
                <p class="text-secondary mb-4">Введите данные, чтобы получить результат.</p>
                <form action="/age" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger"></div>
                    <div class="mb-3">
                        <label for="userName" class="form-label">Ваше имя</label>
                        <input id="userName" name="userName" class="form-control" required maxlength="80" />
                    </div>
                    <div class="mb-4">
                        <label for="age" class="form-label">Ваш возраст</label>
                        <input id="age" name="age" type="number" class="form-control" min="0" max="120" required />
                    </div>
                    <button type="submit" class="btn btn-primary">Рассчитать</button>
                </form>
            </div>
        </div>
    </main>
</body>
</html>
